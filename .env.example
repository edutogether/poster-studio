# ── 필수 ──────────────────────────────────────────────
# OpenAI API 키 (절대 외부에 공유 금지! 채팅·메신저에 붙여넣지 말 것)
OPENAI_API_KEY=여기에_새로_발급받은_OpenAI_API_키를_넣으세요

# 포트 (기본 3000)
PORT=3000

# ── 이미지 모델 ───────────────────────────────────────
# 권장: gpt-image-2  (최신·얼굴보존 우수, 세로 medium 약 $0.04/장)
# 대안: gpt-image-1.5 (안정적), gpt-image-1-mini (가장 저렴)
# ※ 정확한 모델명은 platform.openai.com 모델/요금 페이지에서 확인 후 그대로 입력
IMAGE_MODEL=gpt-image-2

# ── 속도 튜닝 ─────────────────────────────────────────
# 생성 시간은 대부분 OpenAI 서버 연산 시간입니다. 아래 두 값이 가장 큰 손잡이입니다.
#  · IMAGE_QUALITY=low  → 가장 큰 효과(대략 절반 이하로 단축, 비용도 1/3 수준).
#                         4x6 인화에서는 차이가 크지 않은 경우가 많으니 테스트 인쇄로 비교 권장.
#  · INPUT_FIDELITY=off → 얼굴 보존 강화를 꺼서 수~십수 초 단축(유사도 소폭 저하 가능).
# 서버 검은 창에 매 생성마다 걸린 시간이 초 단위로 표시되니 직접 비교해 보세요.

# 화질: low | medium | high  (속도 우선이면 low, 균형 medium)
IMAGE_QUALITY=medium

# 얼굴 보존 강화: high(품질 우선, 기본) | off(속도 우선)
INPUT_FIDELITY=high

# 포스터 비율 (1024x1536 = 세로 2:3, 4x6 인화에 딱 맞음. 2K/4K 불필요)
IMAGE_SIZE=1024x1536

# 한 번에 만드는 AI 그림 장수 (1=빠르고 저렴 → 4컷, 2=더 다양 → 8컷, 2배 비쌈)
VARIANTS=1
